# Supabase Configuration (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Crypto News API Key (CryptoCompare)
# Free key available at https://min-api.cryptocompare.com/
# If omitted, application falls back to public RSS feeds.
# VITE_CRYPTOCOMPARE_API_KEY=your-cryptocompare-api-key

# Note: Server-side environment variables for Supabase Edge Functions
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY) must NEVER be exposed in this frontend client .env file.
